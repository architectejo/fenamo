# Copier ce fichier en `.env` (jamais commité) et renseigner les valeurs.

# --- Django ---
# Développement : peut rester vide (valeur de développement). Production : obligatoire, 50 caractères
# au moins, jamais une valeur commençant par changer / dev / django-insecure.
# Générer : python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=
# Développement : True. Production : toujours False (prod.py force False).
DEBUG=True
# Séparés par des virgules. Production : app.fenamordc.cd
ALLOWED_HOSTS=localhost,127.0.0.1
# Production : https://app.fenamordc.cd
CSRF_TRUSTED_ORIGINS=
LOG_LEVEL=INFO

# --- Base de données ---
# Développement (défaut) : SQLite dans web_app/db.sqlite3 (fichier ignoré par Git).
# DATABASE_URL=sqlite:///db.sqlite3
# Production : MySQL (utf8mb4 ajouté automatiquement).
# DATABASE_URL=mysql://utilisateur:motdepasse@127.0.0.1:3306/nom_base

# --- Fichiers (chemins absolus ; défauts : web_app/staticfiles et web_app/media) ---
# Production cPanel : médias hors du dossier de l'application, par exemple
# STATIC_ROOT=/home/utilisateur/app.fenamordc.cd/staticfiles
# MEDIA_ROOT=/home/utilisateur/app.fenamordc.cd/media
# STATIC_ROOT=
# MEDIA_ROOT=

# --- Production uniquement (fenamo.settings.prod) ---
# DJANGO_SETTINGS_MODULE=fenamo.settings.prod
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
# Courriels (SMTP du compte cPanel)
# EMAIL_HOST=mail.fenamordc.cd
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# DEFAULT_FROM_EMAIL=FENAMO-RDC <noreply@fenamordc.cd>

# --- Liaison avec le site public (website/) ---
# Clé que le site présente à l'API /api/v1/site/
SITE_API_KEY=
# Adresse et secret de la purge du cache du site, appelée à chaque publication de contenu
SITE_PURGE_URL=
SITE_PURGE_SECRET=
