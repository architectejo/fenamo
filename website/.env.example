# Copier en .env (jamais commité). Lu par django-environ.
# Dev : peut rester vide. Production : obligatoire, 50 caractères au moins, aléatoire
# (python -c "from django.core.management.utils import get_random_secret_key as k; print(k())").
SECRET_KEY=
DEBUG=True
# Production : obligatoire (ex. fenamordc.cd,www.fenamordc.cd)
ALLOWED_HOSTS=localhost,127.0.0.1
# Production : obligatoire, avec le schéma (ex. https://fenamordc.cd,https://www.fenamordc.cd)
CSRF_TRUSTED_ORIGINS=
# Adresse publique du site (hreflang, sitemap, Open Graph)
SITE_URL=http://localhost:8001

# API de l'application web (appelée côté serveur uniquement)
# Production : https obligatoire (https://app.fenamordc.cd/api/v1/site/)
API_BASE_URL=http://localhost:8000/api/v1/site/
SITE_API_KEY=
# Délai maximal d'un appel, en secondes (6.2)
API_TIMEOUT=5

# Sonde du verrou F-07 (laisser vide : dérivée de API_BASE_URL, …/api/v1/sante/) et intervalle entre deux sondes
API_SANTE_URL=
API_SANTE_INTERVALLE=30
# Espace des utilisateurs (application web de gestion) : lien du menu et du pied de page
APP_URL=https://app.fenamordc.cd/

# Secret de l'appel de purge du cache par l'application web
PURGE_SECRET=

# Carte Google Maps (page contact uniquement, clé restreinte au domaine)
GOOGLE_MAPS_KEY=

# Repli seulement : les langues actives viennent de la configuration de l'API (F-64) et de leurs .po complets.
# Ce réglage ne sert que si l'API ne répond pas et qu'aucune copie de la configuration n'existe (fr toujours actif).
ACTIVE_LANGUAGES=fr

# True : interdit l'indexation de tout le site (recette, préproduction)
SITE_NOINDEX=False

# Durées de cache par point d'accès, en secondes (6.1)
CACHE_TTL_CONFIG=900
CACHE_TTL_ARTICLES=300
CACHE_TTL_GALERIE=900
CACHE_TTL_COMITE=3600
CACHE_TTL_COORDINATIONS=86400
CACHE_TTL_ASSOCIATIONS=3600
CACHE_TTL_STATISTIQUES=3600
# Durée de conservation de la copie de secours du mode dégradé (S-12)
CACHE_STALE_TTL=2592000
