# Copier en .env (jamais commité). Lu par django-environ.
SECRET_KEY=changer-moi
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Adresse publique du site (hreflang, sitemap, Open Graph)
SITE_URL=http://localhost:8001

# API de l'application web (appelée côté serveur uniquement)
API_BASE_URL=http://localhost:8000/api/v1/site/
SITE_API_KEY=
# Délai maximal d'un appel, en secondes (6.2)
API_TIMEOUT=5

# Secret de l'appel de purge du cache par l'application web
PURGE_SECRET=

# Carte Google Maps (page contact uniquement, clé restreinte au domaine)
GOOGLE_MAPS_KEY=

# Langues actives au lancement (codes séparés par des virgules ; fr toujours actif).
# Valeur provisoire, destinée à être remplacée par la configuration de l'API (F-64).
ACTIVE_LANGUAGES=fr

# True : interdit l'indexation de tout le site (recette, préproduction)
SITE_NOINDEX=False

# Durées de cache par point d'accès, en secondes (6.1)
CACHE_TTL_CONFIG=900
CACHE_TTL_ARTICLES=300
CACHE_TTL_GALERIE=900
CACHE_TTL_COMITE=3600
CACHE_TTL_COORDINATIONS=86400
CACHE_TTL_ASSOCIATIONS=3600
CACHE_TTL_STATISTIQUES=3600
# Durée de conservation de la copie de secours du mode dégradé (S-12)
CACHE_STALE_TTL=2592000
