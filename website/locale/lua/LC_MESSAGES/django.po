msgid "Authentification de la charte par le ministère de la Justice."
msgstr ""

#: templates/pages/a_propos.html
msgid "Les catégories de membres"
msgstr ""

#: templates/pages/a_propos.html
msgid "La fédération comprend cinq catégories de membres (article 8). Les associations agissent par les personnes physiques habilitées à les représenter conformément à leurs statuts."
msgstr ""

#: templates/pages/a_propos.html
msgid "Initiateur fondateur"
msgstr ""

#: templates/pages/a_propos.html
msgid ": la personne physique ayant initié la vision et qui a mis les moyens pour son efficacité et existence de la Fédération."
msgstr ""

#: templates/pages/a_propos.html
msgid "Membres fondateurs et co-fondateurs"
msgstr ""

#: templates/pages/a_propos.html
msgid ": toute personne physique ou association légale ayant participé à la création de la Fédération et ayant également contribué financièrement comme convenu au démarrage des activités ; est co-fondateur tout leader d'opinion indépendant validé par les fondateurs ou représentant des associations nationales ou provinciales ayant participé à l'adoption et signé la charte pour sa légalisation."
msgstr ""

#: templates/pages/a_propos.html
msgid "Membres effectifs"
msgstr ""

#: templates/pages/a_propos.html
msgid ": toute association ainsi que leurs représentants ayant participé à la création de la Fédération et signé la charte pour sa légalisation ; également toute association ou personnalité qui acquiert cette qualité par son adhésion écrite acceptée à la présente charte et au règlement d'ordre intérieur."
msgstr ""

#: templates/pages/a_propos.html
msgid "Membres sympathisants"
msgstr ""

#: templates/pages/a_propos.html
msgid ": toute personne morale ou physique qui a l'idée de soutenir la Fédération sur tous les plans sans espérer une quelconque rémunération."
msgstr ""

#: templates/pages/a_propos.html
msgid "Membres d'honneur"
msgstr ""

#: templates/pages/a_propos.html
msgid ": toute personne physique ou morale qui sollicite d'accompagner valablement le fonctionnement des comités exécutifs ou structures, ou ayant rendu des services particulièrement non lucratifs appréciés par la Fédération."
msgstr ""

